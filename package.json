{
  "name": "jkt48connect-topup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev": "npm run build:client && wrangler dev",
    "build:client": "vite build",
    "build": "npm run build:client && wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "npm run build:client && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply jkt48connect-topup --local",
    "db:migrate:remote": "wrangler d1 migrations apply jkt48connect-topup --remote",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
